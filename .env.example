# ---- Telegram ----
# Rotate via @BotFather /revoke. Never commit the real value.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
MINI_APP_URL=https://ridethatbot.fun

# ---- Database ----
# Internal Coolify service hostname, not the public sslip.io address.
DATABASE_URL=postgres://postgres:CHANGEME@ride-db:5432/ride

# ---- Redis ----
REDIS_URL=redis://ride-redis:6379

# ---- App ----
NODE_ENV=production
PORT=3000
SESSION_SECRET=
CORS_ORIGIN=https://ridethatbot.fun
LOCATION_GRID_METERS=500

# Private channel that stores uploaded media. Bot must be an admin there.
# Format: -100xxxxxxxxxx
TELEGRAM_STORAGE_CHAT_ID=

# Telegram user IDs promoted to admin on sign-in, comma-separated.
# Required to create the FIRST admin: the grant endpoint is admin-only,
# so without this the admin panel stays invisible to everyone and
# verification requests can never be approved.
# Find your ID by messaging @userinfobot.
ADMIN_TELEGRAM_IDS=528269003
