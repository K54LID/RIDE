# ---- Telegram ----
# Rotate via @BotFather /revoke. Never commit the real value.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Public base URL of THE API ITSELF (no trailing slash) — e.g.
# https://api.ridethatbot.fun. NOT the web app's domain: pointing this
# at the site that serves the Mini App sends Telegram's updates to a
# static server and the bot goes silent. The server now verifies the
# URL actually routes to itself before registering the webhook, and
# falls back to polling when it doesn't — but webhooks are still the
# right mode for production, so set this correctly.
PUBLIC_API_URL=
MINI_APP_URL=https://ridethatbot.fun

# ---- Database ----
# Internal Coolify service hostname, not the public sslip.io address.
DATABASE_URL=postgres://postgres:CHANGEME@ride-db:5432/ride

# ---- Redis ----
REDIS_URL=redis://ride-redis:6379

# ---- App ----
NODE_ENV=production
PORT=3000
SESSION_SECRET=
CORS_ORIGIN=https://ridethatbot.fun
LOCATION_GRID_METERS=500

# Private channel that stores uploaded media. The bot must be an
# ADMINISTRATOR of it, not merely a member.
# Format: -100xxxxxxxxxx  (quote it — some env editors strip a leading
# dash, which Telegram rejects as "chat not found"). A bare 100... id or
# a @channelusername are both accepted and normalised.
TELEGRAM_STORAGE_CHAT_ID="-100xxxxxxxxxx"

# Telegram user IDs promoted to admin on sign-in, comma-separated.
# Required to create the FIRST admin: the grant endpoint is admin-only,
# so without this the admin panel stays invisible to everyone and
# verification requests can never be approved.
# Find your ID by messaging @userinfobot.
ADMIN_TELEGRAM_IDS=
